FROM docker.io/library/node@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
       ca-certificates=20230311+deb12u1 \
       git=1:2.39.5-0+deb12u3 \
       libicu72=72.1-3+deb12u1 \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=root:root agent-host /opt/pm-agent-host
COPY --chown=root:root pm /opt/pm
COPY --chown=root:root dotnet /opt/dotnet

RUN chmod -R a-w /opt/pm-agent-host /opt/pm /opt/dotnet \
    && chmod 0555 /opt/pm/PM /opt/pm-agent-host/dist/src/codex/worker-main.js \
    && ln -s /opt/pm/PM /usr/local/bin/pm \
    && ln -s /opt/pm-agent-host/dist/src/codex/worker-main.js /usr/local/bin/pm-agent-worker \
    && ln -s /opt/dotnet/dotnet /usr/local/bin/dotnet

ENV DOTNET_ROOT=/opt/dotnet \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

ARG SOURCE_REVISION
ARG PACKAGE_VERSION
LABEL org.opencontainers.image.title="PM agent worker" \
      org.opencontainers.image.description="Pinned Codex, PM MCP, Git, and .NET 10 validation runtime" \
      org.opencontainers.image.version="${PACKAGE_VERSION}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.chronium.pm.production-ready="true"

WORKDIR /workspace
CMD ["/bin/sleep", "infinity"]
