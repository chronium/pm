[Unit]
Description=PM agent host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pm-agent-host/current/agent-host
EnvironmentFile=%h/.config/pm-agent-host/host.env
ExecStartPre=/usr/bin/podman info
ExecStart=/usr/bin/env node dist/src/main.js serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
