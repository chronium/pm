{
  "displayName": "Linux workstation",
  "agentProviders": [
    {
      "providerId": "codex",
      "modelIds": ["gpt-5.6-sol"],
      "defaultModelId": "gpt-5.6-sol",
      "effortIds": ["low", "medium", "high", "xhigh"],
      "defaultEffortId": "medium"
    }
  ],
  "runtimeProfiles": [
    {
      "profileId": "dotnet-10",
      "revision": "33a364a71ae07e2248370ca096e4d7332342815fe5213c2d6d0fe52ed2dace95",
      "imageReference": "ghcr.io/chronium/pm-agent-dotnet@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "limits": {
        "cpuMillicores": 4000,
        "memoryBytes": 8589934592,
        "pids": 1024,
        "diskBytes": 21474836480,
        "timeoutSeconds": 10800
      },
      "network": {
        "profileId": "development-open",
        "mode": "open"
      },
      "container": {
        "workspacePath": "/workspace",
        "codexHomePath": "/home/pm/.codex",
        "temporaryPath": "/tmp",
        "temporaryBytes": 1073741824,
        "environmentAllowlist": ["CODEX_HOME", "HOME", "PATH"],
        "readOnlyCaches": [],
        "security": {
          "readOnlyRootFilesystem": true,
          "userNamespace": "keep-id",
          "noNewPrivileges": true,
          "dropAllCapabilities": true,
          "privateNamespaces": true,
          "seccompProfile": "runtime-default",
          "lsmProfile": "none"
        }
      },
      "validation": [
        {
          "stepId": "build",
          "displayName": "Build",
          "executable": "dotnet",
          "arguments": ["build", "--no-restore"],
          "workingDirectory": ".",
          "timeoutSeconds": 600
        },
        {
          "stepId": "test",
          "displayName": "Test",
          "executable": "dotnet",
          "arguments": ["test", "--no-restore"],
          "workingDirectory": ".",
          "timeoutSeconds": 900
        }
      ],
      "output": {
        "mode": "patch",
        "maxPatchBytes": 10485760,
        "includeEventLog": true
      }
    }
  ]
}
