<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EmbedAngularAssets Condition="'$(EmbedAngularAssets)' == ''">false</EmbedAngularAssets>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="CodePunk.Highlight" Version="0.3.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1"/>
        <PackageReference Include="ModelContextProtocol" Version="1.4.0"/>
        <PackageReference Include="Spectre.Console" Version="0.54.0"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.53.1"/>
        <PackageReference Include="Spectre.Console.Json" Version="0.54.0"/>
        <PackageReference Include="Spectre.Console.Registrars.Microsoft-Di" Version="0.6.0"/>
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Web/Templates/**/*"/>
    </ItemGroup>

    <ItemGroup Condition="'$(EmbedAngularAssets)' == 'true'">
        <EmbeddedResource Include="../web/dist/pm-web/browser/**/*">
            <LogicalName>PM.AngularAssets/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <Target Name="RequireAngularAssets" BeforeTargets="PrepareForBuild"
            Condition="'$(EmbedAngularAssets)' == 'true'">
        <Error Condition="!Exists('../web/dist/pm-web/browser/index.html')"
               Text="EmbedAngularAssets=true requires web/dist/pm-web/browser/index.html. Run 'npm run build' from web/ before publishing."/>
    </Target>

</Project>
