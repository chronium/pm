{
  "name": "pm-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "check": "ng build --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "node scripts/api-types.mjs",
    "api:types:check": "node scripts/api-types.mjs --check",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "storybook": "ng run pm-web:storybook",
    "build-storybook": "ng run pm-web:build-storybook",
    "test:storybook": "vitest --config vitest.storybook.config.ts --project=storybook --run",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:embedded": "node scripts/run-e2e.mjs embedded",
    "e2e:static": "node scripts/run-e2e.mjs static",
    "frontend:validate": "npm run format:check && npm run api:types:check && npm run check && npm test && npm run test:storybook && npm run build-storybook && npm run build && npm run e2e",
    "release": "node scripts/release.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/forms": "22.0.7",
    "@angular/platform-browser": "22.0.7",
    "@angular/router": "22.0.7",
    "@knadh/oat": "0.6.2",
    "@ng-icons/core": "34.0.0",
    "@ng-icons/css.gg": "34.0.0",
    "dompurify": "3.4.12",
    "easymde": "2.21.0",
    "marked": "18.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@angular/animations": "22.0.7",
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/angular-vite": "10.5.0",
    "@types/node": "26.1.1",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "prettier": "^3.8.1",
    "storybook": "10.5.0",
    "typescript": "~6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite@7.3.5": "7.3.6"
  }
}
